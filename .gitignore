# Python
__pycache__/
*.py[cod]
.venv/
venv/

# IDE
.vscode/
.idea/
.tmp/

# Training outputs
outputs/
logs/
runs/
checkpoints/
wandb/
tensorboard/
reports/

# Model weights
*.pth
*.pt
*.ckpt
*.onnx

# Large/generated data (small manifests and metadata may be tracked).
data/raw/*
data/interim/landmarks/*
data/processed/landmarks/*

# Keep the data contract visible in Git.
!data/raw/.gitkeep
!data/interim/landmarks/.gitkeep
!data/processed/landmarks/.gitkeep

# User-provided MediaPipe task bundles.
models/mediapipe/*.task

# Local cache created while importing MediaPipe's matplotlib dependency.
.tmp-matplotlib/
